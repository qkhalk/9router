# 9Router environment contract
# This file reflects actual runtime usage in the current codebase.

# Required
JWT_SECRET=change-me-to-a-long-random-secret
INITIAL_PASSWORD=change-me
DATA_DIR=/var/lib/9router

# Recommended runtime variables
PORT=20128
NODE_ENV=production

# Recommended security and ops variables
API_KEY_SECRET=endpoint-proxy-api-key-secret
MACHINE_ID_SALT=endpoint-proxy-salt
ENABLE_REQUEST_LOGS=false
OBSERVABILITY_ENABLED=true
AUTH_COOKIE_SECURE=false
REQUIRE_API_KEY=false

# Cloud sync variables
# Must point to this running instance so internal sync jobs can call /api/sync/cloud.
# Server-side preferred variables:
BASE_URL=http://localhost:20128
CLOUD_URL=https://9router.com
# Backward-compatible/public variables:
NEXT_PUBLIC_BASE_URL=http://localhost:20128
NEXT_PUBLIC_CLOUD_URL=https://9router.com

# Optional outbound proxy variables for upstream provider calls
# Lowercase variants are also supported: http_proxy, https_proxy, all_proxy, no_proxy
# HTTP_PROXY=http://127.0.0.1:7890
# HTTPS_PROXY=http://127.0.0.1:7890
# ALL_PROXY=socks5://127.0.0.1:7890
# NO_PROXY=localhost,127.0.0.1

# Currently unused by application runtime (kept as reference)
# INSTANCE_NAME=9router

# ─── Phase 0+: Client Portal + Admin Portal upgrade (NOT YET WIRED) ────────
# These variables are reserved for Phase 1+ and are NOT consumed by current code.
# Do not set them in production until the corresponding phase ships.

# Admin private path prefix (random 32+ chars in production)
# When set, /<value>/* serves the admin web UI; /<ADMIN_API_PREFIX>/* serves admin API.
# Default fallback (dev only) is _dev_ops_change_me / _dev_internal_change_me.
# ADMIN_PATH_PREFIX=_dev_ops_change_me
# ADMIN_API_PREFIX=_dev_internal_change_me

# Cloudflare Turnstile (Phase 1)
# Get keys at https://www.cloudflare.com/products/turnstile/
# In dev, set TURNSTILE_DEV_BYPASS=true to skip verification (NEVER in production).
# TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=
# TURNSTILE_DEV_BYPASS=true

# Google OAuth (Phase 1)
# Create OAuth app at https://console.cloud.google.com/apis/credentials
# Redirect URI must match GOOGLE_REDIRECT_URI exactly.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://localhost:20128/api/auth/google/callback

# Email (SMTP) for OTP delivery (Phase 1)
# Use an app password, not your account password.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM="9Router <no-reply@router.example.com>"

# AES-256-GCM encryption for prompt/response/raw payload (Phase 1/5)
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# ENCRYPTION_KEY=
# ENCRYPTION_KEY_VERSION=1
# ENCRYPTION_KEY_V1=<base64 32-byte>     # used when keyVersion=1
# ENCRYPTION_KEY_V2=<base64 32-byte>     # add V2 after rotation, then bump ENCRYPTION_KEY_VERSION=2

# Gateway key HMAC pepper (Phase 2)
# Different from ENCRYPTION_KEY_V1 — only used for sk-<base64url> client keys.
# GATEWAY_KEY_PEPPER=

# Optional: switch to PostgreSQL (Phase 1+). Default remains SQLite.
# DATABASE_URL=postgresql://user:pass@localhost:5432/9router
# DATABASE_URL=postgres://user:pass@localhost:5432/9router

# Optional: switch to Redis for rate-limit + queue. Default remains in-memory.
# REDIS_URL=redis://localhost:6379

# OTP salt (Phase 1). Generate random 32 bytes base64. Falls back to ENCRYPTION_KEY_V1 if unset.
# OTP_SALT=

# Retention windows in days (Phase 5/7). 0 or negative = no auto-delete.
# RETENTION_REQUEST_METADATA_DAYS=180
# RETENTION_REQUEST_BODY_DAYS=30
# RETENTION_ERROR_DAYS=90
# RETENTION_AUDIT_DAYS=365

# Cloudflare Access for admin path (Phase 7)
# CF_ACCESS_TEAM_DOMAIN=
# CF_ACCESS_AUD=

# Default admin email for legacy password migration (Phase 4)
# ADMIN_DEFAULT_EMAIL=admin@local
